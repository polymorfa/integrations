{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "lib": ["ES2022"], "outDir": "dist", "rootDir": ".",
    "strict": true, "allowJs": true, "checkJs": false,
    "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "declaration": true
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts", "shared/**/*.js"]
}
