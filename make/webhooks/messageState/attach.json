[
  {
    "url": "/platform/projects/{{polymorfaSegment(connection.projectId)}}/webhooks",
    "method": "GET",
    "qs": {
      "limit": 100
    },
    "response": {
      "temp": {
        "ownedId": "{{polymorfaFindHook(body; connection; webhook.url; 'messageState'; parameters.subscriptionKey)}}",
        "activationId": "{{uuid}}"
      },
      "data": {
        "externalHookId": "{{temp.ownedId}}",
        "ownedUrl": "{{webhook.url}}",
        "receiverName": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'name')}}",
        "receiverValue": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'value')}}"
      }
    }
  },
  {
    "condition": "{{!temp.ownedId}}",
    "url": "/platform/projects/{{polymorfaSegment(connection.projectId)}}/webhooks",
    "method": "POST",
    "headers": {
      "Idempotency-Key": "{{polymorfaCreateKey(get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'key'); temp.activationId)}}"
    },
    "body": {
      "url": "{{webhook.url}}",
      "eventTypes": [
        "message.sent",
        "message.ack",
        "message.failed",
        "message.update"
      ],
      "format": "native",
      "enabled": true,
      "headers": [
        {
          "name": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'name')}}",
          "value": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'value')}}"
        }
      ]
    },
    "response": {
      "data": {
        "externalHookId": "{{body.data.webhook.id}}",
        "ownedUrl": "{{webhook.url}}",
        "receiverName": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'name')}}",
        "receiverValue": "{{get(polymorfaHook(connection; 'messageState'; parameters.subscriptionKey); 'value')}}"
      }
    }
  }
]
