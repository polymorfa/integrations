      {
        "value": "image",
        "label": "Image"
      },
      {
        "value": "video",
        "label": "Video"
      },
      {
        "value": "file",
        "label": "File"
      },
      {
        "value": "voice",
        "label": "Voice"
      }
    ]
  },
  {
    "name": "mediaSource",
    "type": "select",
    "label": "Media Source",
    "required": true,
    "default": "url",
    "options": [
      {
        "value": "url",
        "label": "HTTPS URL"
      },
      {
        "value": "base64",
        "label": "Base64 Bytes"
      }
    ]
  },
  {
    "name": "media",
    "type": "text",
    "label": "Media",
    "required": true,
