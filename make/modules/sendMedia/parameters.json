        "label": "Phone Number"
      },
      {
        "value": "id",
        "label": "Conversation ID"
      },
      {
        "value": "bsuid",
        "label": "Business-scoped User ID"
      }
    ]
  },
  {
    "name": "recipient",
    "type": "text",
    "label": "Recipient",
