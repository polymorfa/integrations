{
  "url": "{{get(polymorfaRequest('apiRequest'; parameters; connection); 'url')}}",
  "method": "{{get(polymorfaRequest('apiRequest'; parameters; connection); 'method')}}",
  "headers": "{{get(polymorfaRequest('apiRequest'; parameters; connection); 'headers')}}",
  "qs": "{{get(polymorfaRequest('apiRequest'; parameters; connection); 'query')}}",
  "body": "{{get(polymorfaRequest('apiRequest'; parameters; connection); 'body')}}",
  "type": "json",
  "followRedirect": false,
  "response": {
    "valid": "{{polymorfaResult(statusCode; headers; body) != null}}",
    "output": "{{polymorfaResult(statusCode; headers; body)}}",
    "error": {
      "409": {
        "message": "{{polymorfaError(statusCode; headers; body; get(polymorfaRequest('apiRequest'; parameters; connection); 'method'))}}"
      },
      "429": {
        "type": "RateLimitError",
        "message": "{{polymorfaError(statusCode; headers; body; get(polymorfaRequest('apiRequest'; parameters; connection); 'method'))}}"
      },
      "message": "{{polymorfaError(statusCode; headers; body; get(polymorfaRequest('apiRequest'; parameters; connection); 'method'))}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "request.headers.idempotency-key"
    ]
  }
}
