        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Stable request correlation identifier."
              },
              "X-Trace-Id": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "description": "W3C trace ID of this request. Your `traceparent` trace ID when you sent a valid one."
              },
              "Polymorfa-Version": {
                "schema": {
                  "type": "string"
                },
                "description": "API version applied to this response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ProjectWebhookCreationReceipt"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
